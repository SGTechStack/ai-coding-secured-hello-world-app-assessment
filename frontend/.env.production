# Build-time, non-secret configuration for `vite build`. Every VITE_* value ships in the bundle by design (R-CFG-012).
# Never put a secret here. The bundle is environment-specific: build once per environment, never promote (R-BLD-012).
# VITE_API_ORIGIN stays a placeholder in source control; the deployer overrides it at build time, e.g.
#   VITE_API_ORIGIN=https://api.example.gov.sg npm run build
# VITE_CSP is the production document policy (ADR-060); vite.config.ts adds frame-ancestors to the header copy.
VITE_API_ORIGIN=https://api.example.invalid
VITE_CSP="default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ${VITE_API_ORIGIN}; img-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
