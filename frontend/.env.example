# Build-time, non-secret configuration (R-CFG-012). Copy the shape into .env.<mode>; never put a secret here.
VITE_API_ORIGIN=<api-origin, e.g. https://api.example.gov.sg>
VITE_CSP="default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ${VITE_API_ORIGIN}; img-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
