{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Anatomy of a successful login",
    "viewBox": [
      1080,
      680
    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "locale": "en"
  },
  "participants": [
    {
      "id": "spa",
      "type": "frontend",
      "label": "React SPA",
      "sublabel": "login form"
    },
    {
      "id": "ctrl",
      "type": "backend",
      "label": "AuthController",
      "sublabel": "/api/auth/login"
    },
    {
      "id": "svc",
      "type": "backend",
      "label": "LoginService",
      "sublabel": "ordered checks"
    },
    {
      "id": "throttle",
      "type": "security",
      "label": "IP throttle",
      "sublabel": "per source IP"
    },
    {
      "id": "authm",
      "type": "security",
      "label": "Password check",
      "sublabel": "BCrypt"
    },
    {
      "id": "store",
      "type": "database",
      "label": "Session store",
      "sublabel": "Spring Session JDBC"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 398,
      "label": "1 · Check"
    },
    {
      "from": 410,
      "to": 476,
      "label": "2 · Create session"
    },
    {
      "from": 496,
      "to": 573,
      "label": "3 · Refresh CSRF"
    }
  ],
  "messages": [
    {
      "id": "post-login",
      "from": "spa",
      "to": "ctrl",
      "y": 172,
      "label": "POST /login + CSRF header",
      "variant": "emphasis"
    },
    {
      "id": "call-login",
      "from": "ctrl",
      "to": "svc",
      "y": 207,
      "label": "login(user, pw, IP)",
      "variant": "default"
    },
    {
      "id": "ip-check",
      "from": "svc",
      "to": "throttle",
      "y": 243,
      "label": "fewer than 4 failures?",
      "variant": "security"
    },
    {
      "id": "ip-ok",
      "from": "throttle",
      "to": "svc",
      "y": 278,
      "label": "yes",
      "variant": "return"
    },
    {
      "id": "pw-check",
      "from": "svc",
      "to": "authm",
      "y": 313,
      "label": "account unlocked → verify",
      "variant": "security"
    },
    {
      "id": "pw-ok",
      "from": "authm",
      "to": "svc",
      "y": 349,
      "label": "match",
      "variant": "return"
    },
    {
      "id": "auth-back",
      "from": "svc",
      "to": "ctrl",
      "y": 384,
      "label": "authenticated",
      "variant": "return"
    },
    {
      "id": "save",
      "from": "ctrl",
      "to": "store",
      "y": 426,
      "label": "new session ID + save user",
      "variant": "emphasis"
    },
    {
      "id": "ok",
      "from": "ctrl",
      "to": "spa",
      "y": 457,
      "label": "200 + SESSION cookie",
      "variant": "return"
    },
    {
      "id": "csrf-again",
      "from": "spa",
      "to": "ctrl",
      "y": 520,
      "label": "GET /api/auth/csrf",
      "variant": "default"
    },
    {
      "id": "csrf-new",
      "from": "ctrl",
      "to": "spa",
      "y": 555,
      "label": "new token (JSON)",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "ctrl",
      "from": 166,
      "to": 463,
      "type": "backend"
    },
    {
      "participant": "svc",
      "from": 201,
      "to": 390,
      "type": "backend"
    },
    {
      "participant": "throttle",
      "from": 237,
      "to": 284,
      "type": "security"
    },
    {
      "participant": "authm",
      "from": 308,
      "to": 355,
      "type": "security"
    },
    {
      "participant": "store",
      "from": 420,
      "to": 437,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Order matters",
      "items": [
        "IP throttle first → 429",
        "Then account lock",
        "Then password → generic 401"
      ]
    },
    {
      "dot": "emerald",
      "title": "Session fixation defence",
      "items": [
        "Session ID changes on login",
        "Old session token is thrown away",
        "SPA fetches a fresh token"
      ]
    },
    {
      "dot": "cyan",
      "title": "Logout",
      "items": [
        "POST /api/auth/logout",
        "Deletes the session row",
        "Old cookie no longer works"
      ]
    }
  ]
}
