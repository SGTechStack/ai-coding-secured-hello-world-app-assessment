<?xml version="1.0" encoding="UTF-8"?>
<ruleset xmlns="http://mojo.codehaus.org/versions-maven-plugin/rule/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://mojo.codehaus.org/versions-maven-plugin/rule/2.0.0 http://mojo.codehaus.org/versions-maven-plugin/schema/rule-2.0.0.xsd">
  <!-- Exclude snapshots and milestones from all updates -->
  <ignoreVersions>
    <!-- Snapshots -->
    <ignoreVersion type="regex">^.*-SNAPSHOT$</ignoreVersion>
    <!-- Milestones (M1, M2, etc.) -->
    <ignoreVersion type="regex">^.*-M\d+$</ignoreVersion>
    <!-- Alpha/Beta/RC versions (optional, uncomment if needed) -->
    <!-- <ignoreVersion type="regex">^.*-(Alpha|alpha|ALPHA|Beta|beta|BETA|RC|rc).*$</ignoreVersion> -->
  </ignoreVersions>
</ruleset>

