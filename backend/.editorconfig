# Top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.java]
# Google Java Format: 2-space indent, 100-char line length, 4-space continuation
indent_size = 2
continuation_indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

# Notes:
# This repository uses Spotless with googleJavaFormat as the canonical formatter.
# .editorconfig provides basic editor-friendly defaults so IDEs will behave
# consistently. Real formatting is performed by running `./mvnw spotless:apply`.
