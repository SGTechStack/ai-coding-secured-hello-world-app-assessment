  "user_stories": [
    { "id": "INFRA-BE-01", "title": "Backend cross-cutting infrastructure is ready", "group": "infra_backend", "category": "infrastructure", "owned_nodes": ["logging", "exception_mapping", "openapi_docs", "be_arch_tests"], "verifiable": "Structured logs emit with correlation IDs, errors return ProblemDetail responses, Swagger UI is reachable in dev, ArchUnit tests pass", "duration_assumptions": "logback + MDC filter, @RestControllerAdvice with ProblemDetail, springdoc, ArchUnit" },
    { "id": "INFRA-BE-02", "title": "Session auth foundation is operational", "group": "infra_backend", "category": "infrastructure", "owned_nodes": ["auth_service"], "verifiable": "Unauthenticated /api/** returns 401 JSON, session cookie is HttpOnly/SameSite, CSRF token endpoint works, CORS allows the frontend origin with credentials", "duration_assumptions": "Spring Security SecurityFilterChain + Spring Session in-memory indexed repository + CookieSerializer" },
    { "id": "INFRA-FE-01", "title": "Frontend data & routing layer is ready", "group": "infra_frontend", "category": "infrastructure", "owned_nodes": ["project_setup", "routing_setup", "state_management", "api_client", "fe_arch_tests"], "verifiable": "App loads on :3000, routes navigate, fetch wrapper sends credentials and CSRF header, lint and typecheck pass", "duration_assumptions": "Vite + React 19 + TS strict, React Router, TanStack Query, fetch wrapper" },
    { "id": "INFRA-FE-02", "title": "Design system & component library is ready", "group": "infra_frontend", "category": "infrastructure", "owned_nodes": ["design_tokens", "component_lib"], "verifiable": "CSS variables applied; Button/Input/Card/Alert render with token values", "duration_assumptions": "CSS variables, hand-rolled atoms (no external UI lib)" },
    { "id": "INFRA-FE-03", "title": "Users can log in via the frontend", "group": "infra_frontend", "category": "infrastructure", "owned_nodes": ["auth_ui"], "verifiable": "Session query drives route guards; protected routes redirect to /login; admin routes require ADMIN", "duration_assumptions": "AuthProvider over TanStack Query session lookup" },
    { "id": "1", "title": "As a visitor, I want to register an account with a username, email, and password, so that I can log in and access the protected app.", "group": "registration", "category": "feature", "owned_nodes": ["be_user_db_schema", "be_user_data_access", "be_user_registration_service", "be_user_registration_routes", "fe_register_form"], "duration_assumptions": "Single users table, Bean Validation DTO, BCrypt, React form" },
    { "id": "2", "title": "As a registered user, I want to log in with my username and password, so that I can access my session and the protected app content.", "group": "login", "category": "feature", "owned_nodes": ["be_auth_login_service", "be_auth_login_routes", "fe_login_form"], "duration_assumptions": "AuthenticationManager + DaoAuthenticationProvider, explicit session-fixation strategy, JSON login endpoint" },
    { "id": "3", "title": "As a security-conscious operator, I want repeated failed logins to trigger account lockout and IP-level throttling, so that brute-force credential guessing is blunted.", "group": "login", "category": "feature", "owned_nodes": ["be_auth_lockout_service", "be_auth_throttle_middleware"], "duration_assumptions": "Counter + locked_until on users row; in-memory sliding window per IP" },
    { "id": "4", "title": "As a logged-in user, I want to log out, so that my session is fully ended and cannot be reused.", "group": "logout", "category": "feature", "owned_nodes": ["be_auth_logout_routes", "fe_logout_widget"], "duration_assumptions": "Spring Security logout handler deleting the Spring Session entry" },
    { "id": "5", "title": "As a logged-in user, I want to see a personalized greeting, so that I can confirm my authentication actually worked.", "group": "protected_content", "category": "feature", "owned_nodes": ["be_hello_routes", "fe_hello_page"], "duration_assumptions": "Single authenticated endpoint + page" },
    { "id": "6", "title": "As a user who forgot their password, I want to request a password reset via my registered email, so that I can regain access without contacting an admin.", "group": "password_reset", "category": "feature", "owned_nodes": ["be_password_reset_db_schema", "be_password_reset_data_access", "be_notification_integration", "be_password_reset_request_service", "be_password_reset_routes", "fe_password_reset_request_form"], "duration_assumptions": "Token table with SHA-256 hash, SecureRandom token, stub EmailService logging the link" },
    { "id": "7", "title": "As a user with a valid reset token, I want to set a new password, so that I can regain access to my account.", "group": "password_reset", "category": "feature", "owned_nodes": ["be_password_reset_confirm_service", "fe_password_reset_confirm_form"], "duration_assumptions": "Token lookup by hash, single-use + expiry checks, delete all sessions for principal" },
    { "id": "8", "title": "As an admin, I want to see a list of all registered users, so that I can review who has access to the system.", "group": "admin_user_management", "category": "feature", "owned_nodes": ["be_user_admin_service", "be_user_admin_routes", "fe_user_admin_page", "fe_user_admin_list"], "duration_assumptions": "DTO projection (no hashes), hasRole(ADMIN) at filter chain + @PreAuthorize, simple table" },
    { "id": "9", "title": "As an admin, I want to enable or disable another user's account, so that I can suspend access without deleting their data.", "group": "admin_user_management", "category": "feature", "owned_nodes": ["be_user_status_service", "fe_user_status_widget"], "duration_assumptions": "PATCH status endpoint with self-action guard" },
    { "id": "10", "title": "As an admin, I want to change another user's role between USER and ADMIN, so that I can grant or revoke admin privileges.", "group": "admin_user_management", "category": "feature", "owned_nodes": ["be_user_role_service", "fe_user_role_widget"], "duration_assumptions": "PATCH role endpoint with self-action guard" },
    { "id": "11", "title": "As an admin, I want to delete another user's account, so that I can remove accounts that should no longer exist.", "group": "admin_user_management", "category": "feature", "owned_nodes": ["be_user_delete_service", "fe_user_delete_modal"], "duration_assumptions": "DELETE endpoint with self-action guard; cascades reset tokens" },
    { "id": "12", "title": "As an operator deploying the app for the first time, I want an initial admin account to be created automatically, so that there's a way into the admin module without manual database edits.", "group": "admin_bootstrap", "category": "feature", "owned_nodes": ["be_user_admin_config", "be_user_admin_bootstrap_job"], "duration_assumptions": "@ConfigurationProperties + ApplicationRunner, idempotent on existing ADMIN" }
  ]
}
