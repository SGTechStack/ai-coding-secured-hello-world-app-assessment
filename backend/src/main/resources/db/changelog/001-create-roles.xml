<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Minimal and read-only, seeded from application.yaml at startup (spec.md S2, ticket 03).
    Std:407 / :415 make persisting role definitions an enforced constraint; no endpoint creates,
    modifies or deletes a row here.
  -->
  <changeSet id="001-create-roles" author="secured-login-app">
    <createTable tableName="roles">
      <column name="id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(50)">
        <constraints nullable="false" unique="true" uniqueConstraintName="uk_roles_name"/>
      </column>
    </createTable>
  </changeSet>
</databaseChangeLog>
