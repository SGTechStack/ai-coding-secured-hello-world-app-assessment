<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging layout (ticket 14): ordinary application/framework logs keep the
  standard Boot console pattern; the dedicated "audit" logger emits one JSON
  object per security event through the LogstashEncoder appender (ticket 06
  decision — genuinely machine-parseable audit lines). additivity=false keeps
  audit events out of the pattern appender so each appears exactly once.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="AUDIT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <logger name="audit" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_JSON"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
