# Build output (regenerated by mvn / vite -- never committed)
backend/target/
frontend/dist/
frontend/node_modules/

# Secrets / env (keep the committed example template)
.env
.env.local
.env.*.local
*.pem
*.key
!.env.example

# Logs
*.log
logs/

# IDE / OS cruft
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.swp

# Ignore the per-tool skill mirror folders.
# skills-lock.json (the manifest) stays tracked; app code (backend/, frontend/,
# docs/, prd/) stays tracked.

# Top-level skills source
/skills/

