# Required environment for the secured login app (spec.md S1).
#
# Secrets come from the environment with NO committed defaults. This file documents the set; it
# holds no real values and is the only place these names are written down in version control.

# --- Initial administrator bootstrap (spec.md S9) -------------------------------------------
# Seeded on first start only, when no user holds USER_MANAGER in any state.
#
# APP_ADMIN_PASSWORD is MANDATORY. If it is absent, or violates the password policy, startup
# FAILS -- it never falls back to a default or guessable credential. It must satisfy the same
# policy as any other password: 12-72 printable ASCII characters, not on the denylist, and not
# containing the username or the email local part.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_ADMIN_EMAIL=admin@example.com

# --- Database (spec.md S2) ------------------------------------------------------------------
# PostgreSQL is the declared target. The `dev` and `test` profiles override these with H2 in
# MODE=PostgreSQL and need none of them set.
DB_URL=jdbc:postgresql://localhost:5432/securedlogin
DB_USERNAME=
DB_PASSWORD=

# --- OWASP dependency-check (spec.md S1, S12) -----------------------------------------------
# Only needed for `mvn -Powasp verify`. The first run without a key is very slow.
NVD_API_KEY=
