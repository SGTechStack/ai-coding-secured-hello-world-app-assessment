<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>sg.securedhello</groupId>
    <artifactId>secured-hello-world</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>secured-hello-world</name>
    <description>Secured Hello World REST API</description>

    <properties>
        <java.version>21</java.version>
        <!-- Pinned exactly: the skip-property behaviour is version-specific (R-BLD-005; ADR-069). -->
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <archunit.version>1.5.1</archunit.version>
        <!-- Boot 4.1.1 (newest 4.1.x) ships Tomcat 11.0.24. 11.0.25+ fixes CVE-2026-65637, -65905, -65182, -68525,
             -65183, -66422, -68569, -65927, -68763 (CVSS 7.5-9.8) and -73180, -66299. Drop this override once
             Boot manages 11.0.25 or later (R-BLD-007). -->
        <tomcat.version>11.0.26</tomcat.version>

        <!-- Build gates (ticket 03). Paths are relative to this module; moving a file is a one-line change here. -->
        <test-plan.path>${project.basedir}/../docs/test-plan/test-plan.md</test-plan.path>
        <traceability.ledger.path>${project.basedir}/../docs/test-plan/pending-ledger.txt</traceability.ledger.path>
        <traceability.frontend.dir>${project.basedir}/../frontend</traceability.frontend.dir>
        <register.path>${project.basedir}/../docs/register/register.md</register.path>
        <register.compliance.path>${project.basedir}/../docs/register/deferral-register.md</register.compliance.path>
        <register.handover.path>${project.basedir}/../docs/register/handover.md</register.handover.path>
        <!-- -Dregister.regenerate=true rewrites both renderings instead of checking them (ADR-069). -->
        <register.regenerate>false</register.regenerate>
        <dependency-check-maven.version>13.0.0</dependency-check-maven.version>
        <!-- Fail on any dependency finding of CVSS 7.0 or higher, High and Critical (R-BLD-007; R-BLD-010). -->
        <dependency-check.failBuildOnCVSS>7</dependency-check.failBuildOnCVSS>
        <pitest-maven.version>1.30.0</pitest-maven.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
        <json-schema-validator.version>3.0.7</json-schema-validator.version>
        <!-- The limiter's buckets (R-STD-011): the core module only, with our own Caffeine cache. -->
        <bucket4j.version>8.20.0</bucket4j.version>
        <!-- The password strength gate (ADR-005): pinned; T-CRED-004 must pass again before it moves. -->
        <zxcvbn.version>1.9.0</zxcvbn.version>
        <!-- The server-rendered TOTP provisioning QR code (ADR-025): the core encoder only; PNG is written by ImageIO. -->
        <zxing.version>3.5.3</zxing.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Tracing: trace.id and span.id on every log line; inbound context is restarted (ADR-063). No exporter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- Metrics leave only by OTLP push, switched off unless the otlp profile is active (ADR-061). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>
        <!-- AuthRateLimiter (ADR-010; ADR-017): in-memory buckets in bounded caches, single instance (REJ-018). -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nulab-inc</groupId>
            <artifactId>zxcvbn</artifactId>
            <version>${zxcvbn.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
        </dependency>
        <!-- Base32 for the TOTP manual-entry secret and otpauth URI (RFC 4648); version managed by Spring Boot. -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Validates error bodies against the JSON Schema generated from the closed code enum (T-AUTH-011). -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- One JVM, one test at a time: the shared clock, contexts and stream captures need it (REJ-058). -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <systemPropertyVariables>
                        <!-- Tests write the audit file under target/, and LogOutputGuard scans it there. -->
                        <app.audit.directory>${project.build.directory}/audit-logs</app.audit.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <configuration>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- Inputs of the traceability gate (ADR-068) and the register drift gate (ADR-069). -->
                    <systemPropertyVariables>
                        <test-plan.path>${test-plan.path}</test-plan.path>
                        <traceability.ledger.path>${traceability.ledger.path}</traceability.ledger.path>
                        <traceability.frontend.dir>${traceability.frontend.dir}</traceability.frontend.dir>
                        <register.path>${register.path}</register.path>
                        <register.compliance.path>${register.compliance.path}</register.compliance.path>
                        <register.handover.path>${register.handover.path}</register.handover.path>
                        <register.regenerate>${register.regenerate}</register.regenerate>
                        <!-- The repackaged jar, which the build-artefact check opens (T-BLD-004). -->
                        <build.jar.path>${project.build.directory}/${project.build.finalName}.jar</build.jar.path>
                        <app.audit.directory>${project.build.directory}/audit-logs</app.audit.directory>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- OWASP Dependency-Check in verify, failing at the CVSS threshold (R-BLD-007; R-BLD-010).
                     NVD_API_KEY, when set, speeds up the NVD download. -Ddependency-check.skip=true is for local
                     inner loops only; a release build never sets it (backend/README.md). -->
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check-maven.version}</version>
                <configuration>
                    <failBuildOnCVSS>${dependency-check.failBuildOnCVSS}</failBuildOnCVSS>
                    <!-- Verified false positives, each scoped to its artifacts and CVE (README, Build gates). -->
                    <suppressionFiles>
                        <suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <!-- OSS Index now needs an account; without one its remote errors warn instead of failing. -->
                    <ossIndexWarnOnlyOnRemoteErrors>true</ossIndexWarnOnlyOnRemoteErrors>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <!-- PIT over the security-decision classes (spec, Mandatory gates 7). Run with -Pmutation. -->
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest-maven.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5-plugin.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <mutationThreshold>85</mutationThreshold>
                        <!-- The scope, matched by class name so it holds whichever package a ticket picks. A ticket
                             that builds one of these classes keeps its entry matching the real class name. -->
                        <targetClasses>
                            <!-- the lockout counter and ladder -->
                            <param>sg.securedhello.*LockoutCounter*</param>
                            <param>sg.securedhello.*LockoutLadder*</param>
                            <param>sg.securedhello.*AdminActionGuard*</param>
                            <param>sg.securedhello.*SourceKeyResolver*</param>
                            <!-- the PasswordService policy -->
                            <param>sg.securedhello.*PasswordPolicy*</param>
                            <!-- token hashing and consume -->
                            <param>sg.securedhello.*TokenHash*</param>
                            <param>sg.securedhello.*TokenConsum*</param>
                            <!-- the TOTP window and replay check -->
                            <param>sg.securedhello.*TotpWindow*</param>
                            <param>sg.securedhello.*TotpReplay*</param>
                            <!-- the two-tier factor lockout: the counting and the verification that applies it -->
                            <param>sg.securedhello.*TotpUserDetails</param>
                            <param>sg.securedhello.*TotpVerification</param>
                            <!-- the TOTP envelope: context prefix and version-keyed key ring -->
                            <param>sg.securedhello.*TotpSecretCipher*</param>
                            <!-- emitter key validation -->
                            <param>sg.securedhello.*EmitterKeyValidat*</param>
                            <!-- Anonymous-session shed lines, bands and dwell (ADR-041). -->
                            <param>sg.securedhello.*ShedEpisode*</param>
                            <!-- The startup reconciliation sweep: its triggers and the sweep (ADR-039). -->
                            <param>sg.securedhello.*Reconciliation*</param>
                            <param>sg.securedhello.*SessionTerminationService*</param>
                            <!-- The recovery runner's digest and command line (ADR-073; ADR-074). -->
                            <param>sg.securedhello.*RecoveryPlan*</param>
                            <param>sg.securedhello.*RecoveryInvocation*</param>
                        </targetClasses>
                        <!-- Until those classes exist there is nothing to mutate; that alone must not fail. -->
                        <failWhenNoMutations>false</failWhenNoMutations>
                        <!-- The minions need an audit directory, or the audit-file tests fail before any mutation. It is not
                             Surefire's: mutants write degraded rows, which LogOutputGuard would find on the next run. -->
                        <jvmArgs>
                            <value>-Dapp.audit.directory=${project.build.directory}/pit-audit-logs</value>
                        </jvmArgs>
                        <timestampedReports>false</timestampedReports>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <!-- Active only when NVD_API_KEY is set: an empty key is refused by the NVD API, no key is not. -->
            <id>nvd-api-key</id>
            <activation>
                <property>
                    <name>env.NVD_API_KEY</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <configuration>
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <executions>
                            <execution>
                                <id>mutation-coverage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
