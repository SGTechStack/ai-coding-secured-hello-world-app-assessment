  "nodes": [
    { "id": "logging", "name": "Structured logging (logback, correlation-id MDC filter, audit logger)", "duration_days": 0.5, "tooling": ["logback + MDC filter (Spring Boot)"], "category": "backend" },
    { "id": "exception_mapping", "name": "HTTP exception mapping (@RestControllerAdvice, ProblemDetail)", "duration_days": 0.25, "tooling": ["@ControllerAdvice (Spring Boot)"], "category": "backend" },
