{
  "description": "Shared password-rule cases run by both the backend (PasswordPolicyTest) and the frontend (password-policy.test.ts). The backend-only common-password check is deliberately excluded.",
  "cases": [
    { "name": "valid mixed password", "password": "Str0ng!Passw0rd", "username": "testuser123", "email": "testuser123@test.example.com", "codes": [] },
    { "name": "exactly 12 characters", "password": "Abcdefgh1!xy", "username": "testuser123", "email": "testuser123@test.example.com", "codes": [] },
    { "name": "exactly 72 characters", "password": "Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!", "username": "testuser123", "email": "testuser123@test.example.com", "codes": [] },
    { "name": "73 characters exceeds the BCrypt limit", "password": "Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!Aa1!x", "username": "testuser123", "email": "testuser123@test.example.com", "codes": ["PASSWORD_TOO_LONG"] },
    { "name": "11 characters is too short", "password": "Abcdefg1!xy", "username": "testuser123", "email": "testuser123@test.example.com", "codes": ["PASSWORD_TOO_SHORT"] },
    { "name": "missing uppercase", "password": "lowercase12345!", "username": "testuser123", "email": "testuser123@test.example.com", "codes": ["PASSWORD_MISSING_UPPERCASE"] },
    { "name": "missing lowercase", "password": "UPPERCASE12345!", "username": "testuser123", "email": "testuser123@test.example.com", "codes": ["PASSWORD_MISSING_LOWERCASE"] },
    { "name": "missing digit", "password": "NoDigitsHere!!", "username": "testuser123", "email": "testuser123@test.example.com", "codes": ["PASSWORD_MISSING_DIGIT"] },
    { "name": "missing special", "password": "NoSpecials1234", "username": "testuser123", "email": "testuser123@test.example.com", "codes": ["PASSWORD_MISSING_SPECIAL"] },
    { "name": "a space counts as a special character", "password": "Has space 12A", "username": "testuser123", "email": "testuser123@test.example.com", "codes": [] },
    { "name": "leading and trailing spaces are kept and valid", "password": "  Leading1Aa  ", "username": "testuser123", "email": "testuser123@test.example.com", "codes": [] },
    { "name": "non-ASCII character", "password": "P\u00e4ssword1234!", "username": "testuser123", "email": "testuser123@test.example.com", "codes": ["PASSWORD_INVALID_CHARACTER"] },
    { "name": "control character", "password": "Tab\tPassword1!", "username": "testuser123", "email": "testuser123@test.example.com", "codes": ["PASSWORD_INVALID_CHARACTER"] },
    { "name": "contains the username case-insensitively", "password": "MyTESTUSER123!x", "username": "TestUser123", "email": "other@test.example.com", "codes": ["PASSWORD_CONTAINS_IDENTITY"] },
    { "name": "contains the email local part", "password": "Jane.Doe#2026xx", "username": "testuser123", "email": "jane.doe@test.example.com", "codes": ["PASSWORD_CONTAINS_IDENTITY"] },
    { "name": "email local part shorter than 4 is ignored", "password": "Xabc12345678!", "username": "testuser123", "email": "abc@test.example.com", "codes": [] },
    { "name": "every composition rule reported together", "password": "short", "username": "testuser123", "email": "testuser123@test.example.com", "codes": ["PASSWORD_TOO_SHORT", "PASSWORD_MISSING_UPPERCASE", "PASSWORD_MISSING_DIGIT", "PASSWORD_MISSING_SPECIAL"] },
    { "name": "empty password is required", "password": "", "username": "testuser123", "email": "testuser123@test.example.com", "codes": ["FIELD_REQUIRED"] }
  ]
}
