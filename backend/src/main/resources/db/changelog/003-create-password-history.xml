<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    spec.md S2 / S5, ticket 04. Holds the CURRENT hash as its newest row, which is what makes
    "block four values" a single query: current plus three previous.

    ON DELETE CASCADE is load-bearing — a tombstoned account's history must disappear with it
    (story 1.19), and the tombstone never carries a password hash.
  -->
  <changeSet id="003-create-password-history" author="secured-login-app">
    <createTable tableName="password_history">
      <column name="id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="user_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="password_hash" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint
        baseTableName="password_history"
        baseColumnNames="user_id"
        constraintName="fk_password_history_user"
        referencedTableName="users"
        referencedColumnNames="id"
        onDelete="CASCADE"/>
    <createIndex tableName="password_history" indexName="ix_password_history_user">
      <column name="user_id"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
