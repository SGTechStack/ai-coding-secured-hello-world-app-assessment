# Production API origin -- PLACEHOLDER, deliberately left unset.
#
# `npm run build` (vite build, production mode) FAILS unless VITE_API_BASE_URL
# is provided, either by uncommenting and editing the line below or (preferred)
# via the build environment, e.g.:
#
#   VITE_API_BASE_URL=https://api.your-real-domain.example npm run build
#
# Must be an absolute https:// URL with no trailing slash.
# VITE_API_BASE_URL=https://api.REPLACE-ME.example
