<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>local.builderday</groupId>
  <artifactId>builderday</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <properties>
    <!-- Pinned to remediate the vulnerability in the previously managed 11.0.24 release. -->
    <tomcat.version>11.0.26</tomcat.version>
    <!-- Pinned to remediate CVE-2026-68497, CVE-2026-83557 and CVE-2026-19032 in the managed 3.1.5 (fixed in 3.1.6). -->
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <java.version>21</java.version>
    <bucket4j.version>8.20.0</bucket4j.version>
    <shedlock.version>7.10.1</shedlock.version>
    <bouncycastle.version>1.86</bouncycastle.version>
    <archunit.version>1.5.1</archunit.version>
    <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
    <jacoco.version>0.8.15</jacoco.version>
    <download-maven-plugin.version>1.13.0</download-maven-plugin.version>
    <!-- Highest today is 11 (AccountRules#passwordViolations, AccountHygieneJob#apply). -->
    <jacoco.max-method-complexity>15</jacoco.max-method-complexity>
    <!-- Pinned OSV-Scanner release for the dependency-scan profile; each OS profile pins its binary's SHA-256. -->
    <osv-scanner.version>2.6.0</osv-scanner.version>
    <!-- Default for the frontend coverage execution's skip; -DskipTests overrides it. -->
    <skipTests>false</skipTests>
    <frontend.directory>${project.basedir}/../frontend</frontend.directory>
    <!-- Resolved from PATH; exec-maven-plugin adds npm.cmd via PATHEXT on Windows. Override with -Dnpm.executable=<path>. -->
    <npm.executable>npm</npm.executable>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-liquibase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-session-jdbc</artifactId>
    </dependency>
    <!-- Durable, JDBC-backed rate limiting (Apache-2.0). Pinned exactly; reviewed for the Java 21 runtime and PostgreSQL. -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-postgresql</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <!-- Distributed scheduling lock so only one instance runs the rate-limit cleanup (Apache-2.0). Pinned exactly. -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
      <version>${shedlock.version}</version>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
      <version>${shedlock.version}</version>
    </dependency>
    <!-- In-memory self-signed certificate for the ALB-to-application TLS hop (MIT). Pinned exactly. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>
    <!-- The cloud database driver (dev, sit, prod). Version managed by the Spring Boot BOM. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Tests only; the local Maven profile below adds it for spring-boot:run. Never packaged into the jar. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- The load balancer's health check (GET /actuator/health); only the health endpoint is exposed. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Compile time only: generates metadata for the app.* keys so the IDE validates application*.yml. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Architecture rules in BackendArchitectureTest (Apache-2.0). Pinned exactly. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>db</directory>
        <targetPath>db</targetPath>
      </resource>
      <resource>
        <directory>${frontend.directory}/dist</directory>
        <targetPath>static</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- No deprecated or for-removal APIs: javac reports every use and any warning fails the build. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:deprecation,removal</arg>
          </compilerArgs>
          <failOnWarning>true</failOnWarning>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>install-frontend-dependencies</id>
            <!-- The IDE build must not run npm; Maven still does. -->
            <?m2e ignore?>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${npm.executable}</executable>
              <workingDirectory>${frontend.directory}</workingDirectory>
              <arguments>
                <argument>ci</argument>
                <argument>--ignore-scripts</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>build-frontend</id>
            <!-- The IDE build must not run npm; Maven still does. -->
            <?m2e ignore?>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${npm.executable}</executable>
              <workingDirectory>${frontend.directory}</workingDirectory>
              <arguments>
                <argument>run</argument>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>
          <!-- Frontend tests with a 90% line-coverage gate (frontend/vite.config.ts), beside the JaCoCo gate, so
               plain `mvn package` fails on either. -DskipTests skips both. -->
          <execution>
            <id>test-frontend-coverage</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>${npm.executable}</executable>
              <workingDirectory>${frontend.directory}</workingDirectory>
              <arguments>
                <argument>run</argument>
                <argument>coverage</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- spring-boot:run only: puts backend/local/ (local seed changelog) on the classpath. Never packaged into the jar. -->
          <additionalClasspathElements>
            <additionalClasspathElement>${project.basedir}/local</additionalClasspathElement>
          </additionalClasspathElements>
        </configuration>
      </plugin>
      <!-- Coverage and complexity gate on unit tests, enforced before packaging so plain `mvn package` fails on it.
           JaCoCo has no CRAP metric; capping per-method complexity alongside coverage bounds its complexity-squared term. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>METHOD</element>
                  <limits>
                    <limit>
                      <counter>COMPLEXITY</counter>
                      <value>TOTALCOUNT</value>
                      <maximum>${jacoco.max-method-complexity}</maximum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- The OSV-Scanner release binary for this OS, used by the dependency-scan profile. -->
    <profile>
      <id>osv-scanner-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <osv-scanner.asset>osv-scanner_windows_amd64.exe</osv-scanner.asset>
        <osv-scanner.sha256>e0ed7644118b717b028c249ee9d3515024e55e8510747ca08906eb96765354d6</osv-scanner.sha256>
      </properties>
    </profile>
    <profile>
      <id>osv-scanner-linux</id>
      <activation>
        <os>
          <family>unix</family>
          <name>Linux</name>
        </os>
      </activation>
      <properties>
        <osv-scanner.asset>osv-scanner_linux_amd64</osv-scanner.asset>
        <osv-scanner.sha256>ca69b3d3cd08f889a49dc0a383122f71cc528b83803671df5fd874d97485b108</osv-scanner.sha256>
      </properties>
    </profile>
    <!-- Known-vulnerability scan (OWASP A06, IM8 patching), no API key: `mvn verify -Pdependency-scan`.
         Backend: OSV-Scanner on Boot's CycloneDX SBOM of the shipped (non-test) dependencies; any known vulnerability fails
         the build unless osv-scanner.toml ignores it with a reason and an expiry. Frontend: npm audit of the shipped
         (non-dev) dependencies at High or above. Sends package names and versions, never code, to osv.dev and npm. -->
    <profile>
      <id>dependency-scan</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.googlecode.maven-download-plugin</groupId>
            <artifactId>download-maven-plugin</artifactId>
            <version>${download-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>download-osv-scanner</id>
                <phase>package</phase>
                <goals>
                  <goal>wget</goal>
                </goals>
                <configuration>
                  <url>https://github.com/google/osv-scanner/releases/download/v${osv-scanner.version}/${osv-scanner.asset}</url>
                  <sha256>${osv-scanner.sha256}</sha256>
                  <outputDirectory>${project.build.directory}/osv-scanner/${osv-scanner.version}</outputDirectory>
                  <outputFileName>${osv-scanner.asset}</outputFileName>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- Runs the Spring Boot parent's managed execution (version and config from the parent): a CycloneDX SBOM of
               the compile and runtime dependencies at target/classes/META-INF/sbom/application.cdx.json, no test scope. -->
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>osv-scan-backend</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${project.build.directory}/osv-scanner/${osv-scanner.version}/${osv-scanner.asset}</executable>
                  <arguments>
                    <argument>scan</argument>
                    <argument>source</argument>
                    <argument>--config=${project.basedir}/osv-scanner.toml</argument>
                    <argument>--lockfile=${project.build.outputDirectory}/META-INF/sbom/application.cdx.json</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>npm-audit-frontend</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${npm.executable}</executable>
                  <workingDirectory>${frontend.directory}</workingDirectory>
                  <arguments>
                    <argument>audit</argument>
                    <argument>--omit=dev</argument>
                    <argument>--audit-level=high</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Local development's in-memory database. Activated by the README's run command
         (-Dspring-boot.run.profiles=local), so the packaged jar never carries H2. -->
    <profile>
      <id>local</id>
      <activation>
        <property>
          <name>spring-boot.run.profiles</name>
          <value>local</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.h2database</groupId>
          <artifactId>h2</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
