<?xml version="1.0" encoding="UTF-8"?>
<!--
Documented escape hatch for OWASP Dependency-Check false positives in `mvn -P security verify`.
Empty on purpose: nothing is suppressed today.

Add an entry only for a finding that has been looked at and shown not to apply to this application,
and say why and until when in the `notes`. A suppression is a decision to ship a known CVE report
unaddressed, so it needs the same scrutiny as an ADR deviation — never add one to make the build pass.

  <suppress until="2027-01-01Z">
    <notes>Why this CVE cannot affect this application.</notes>
    <packageUrl regex="true">^pkg:maven/com\.example/thing@.*$</packageUrl>
    <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
