<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.7</version>
    <relativePath/>
  </parent>

  <groupId>com.assessment</groupId>
  <artifactId>secured-login-app</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>secured-login-app</name>
  <description>Secured login app - Appfw Standalone-Login conformance</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <bucket4j.version>8.20.0</bucket4j.version>
    <archunit.version>1.5.1</archunit.version>
  </properties>

  <dependencies>
    <!-- web / security / persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- session: spec.md S2 - Spring Session JDBC.
         The Boot starter, not the bare spring-session-jdbc artifact: Boot 4 keeps the
         autoconfiguration in its own module, and without it no FindByIndexNameSessionRepository
         bean exists and session revocation has nothing to call. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-session-jdbc</artifactId>
    </dependency>

    <!-- schema: spec.md S2 - Liquibase owns every table.
         Boot 4 splits the autoconfiguration out of the starter: liquibase-core on its own gives
         the engine but no LiquibaseAutoConfiguration, so the changelog silently never runs and
         ddl-auto:validate then fails on a missing table. Both artifacts are required. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-liquibase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
    </dependency>

    <!-- tracing: spec.md S1 - Micrometer Tracing + OpenTelemetry, Actuator as carrier -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>

    <!-- rate limiting: spec.md S1 - Bucket4j (algorithm) + Caffeine (TTL-evicting backing map) -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j_jdk17-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- drivers -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*PostgresIT.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <!--
        spec.md S12: the security-critical suite runs over full HTTP against H2 by default, and
        THE ENTIRE SUITE re-runs against Testcontainers PostgreSQL at `verify`.

        Two executions of the same test classes, not one suite plus a smaller portability suite:
        a behaviour that only holds on H2 has to fail somewhere, and it can only do that if the
        same assertions run on both engines. The second execution sets -Ddb=postgres, which is
        what PostgresContextInitializer switches on; Docker must be available to the build.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <!--
            spring-boot-starter-parent contributes a `default` failsafe execution bound to
            integration-test and verify. Left in place it runs the ENTIRE suite a third time, on H2,
            duplicating the h2-integration-test execution below for about a minute of wall-clock on
            every `verify` and producing a third set of reports that no summaryFile reads.
            Suppressed by phase rather than removed, because an execution inherited from a parent
            cannot be deleted from a child.
          -->
          <execution>
            <id>default</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>h2-integration-test</id>
            <goals>
              <goal>integration-test</goal>
            </goals>
            <configuration>
              <reportsDirectory>${project.build.directory}/failsafe-reports/h2</reportsDirectory>
              <summaryFile>${project.build.directory}/failsafe-reports/h2/failsafe-summary.xml</summaryFile>
            </configuration>
          </execution>
          <execution>
            <id>postgres-integration-test</id>
            <goals>
              <goal>integration-test</goal>
            </goals>
            <configuration>
              <reportsDirectory>${project.build.directory}/failsafe-reports/postgres</reportsDirectory>
              <summaryFile>${project.build.directory}/failsafe-reports/postgres/failsafe-summary.xml</summaryFile>
              <systemPropertyVariables>
                <db>postgres</db>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <execution>
            <id>verify-both</id>
            <goals>
              <goal>verify</goal>
            </goals>
            <configuration>
              <!-- Both summaries, so a PostgreSQL-only failure still fails the build. -->
              <summaryFiles>
                <summaryFile>${project.build.directory}/failsafe-reports/h2/failsafe-summary.xml</summaryFile>
                <summaryFile>${project.build.directory}/failsafe-reports/postgres/failsafe-summary.xml</summaryFile>
              </summaryFiles>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- spec.md S1: dependency-check in a NON-DEFAULT profile, failBuildOnCVSS=7 -->
    <profile>
      <id>owasp</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>12.1.3</version>
            <configuration>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
            </configuration>
            <executions>
              <execution>
                <goals><goal>check</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
