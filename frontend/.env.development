# The dev server proxies /api, /login and /logout to the backend on :8080, so every URL stays
# relative and same-origin (ADR-DEMO-0002). Sign in with the seeded admin (see README).
VITE_LOGIN_URL=/app/sign-in
VITE_LOGOUT_URL=/logout
VITE_SIGNIN_URL=/welcome

