    {
      "dot": "cyan",
      "title": "SESSION cookie",
      "items": [
        "The only cookie",
        "HttpOnly: JavaScript cannot read it",
        "Prod: Secure + SameSite=Strict"
      ]
    },
    {
      "dot": "amber",
      "title": "CSRF token",
      "items": [
        "Stored in the server session",
        "SPA keeps it in memory, never a cookie",
        "Replaced on login, cleared on logout"
      ]
    },
