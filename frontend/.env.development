# Default dev backend runs plain `local` (mock login page). To test the real OIDC flow locally,
# start the backend with `local,feat-oidc` and override in .env.local:
VITE_LOGIN_URL=http://localhost:8080/login
VITE_LOGOUT_URL=http://localhost:8080/logout
VITE_SIGNIN_URL=http://localhost:8080/welcome

# VITE_LOGIN_URL=https://demo.local:8443/oauth2/authorization/aas
# VITE_LOGOUT_URL=https://demo.local:8443/logout
# VITE_SIGNIN_URL=https://demo.local:8443/welcome

