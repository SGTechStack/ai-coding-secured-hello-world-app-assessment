digraph workflow {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.32", ranksep="0.42", fontname="Segoe UI"];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=12, margin="0.18,0.10", color="#2563eb", fillcolor="#eff6ff", fontcolor="#172554"];
  edge [fontname="Segoe UI", fontsize=10, color="#475569", arrowsize=0.7];

  foundation [label="0. Foundation setup\n(once per project)", fillcolor="#e0f2fe"];
  ready [shape=diamond, label="Foundation\nhealthy?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  foundation_fix [label="Stop campaign → later\nfoundation task: fix + re-smoke", fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d"];
  campaign_start [label="Campaign start\nwarm stack + verify foundation", fillcolor="#e0f2fe"];
  campaign_ready [shape=diamond, label="Stack and manifest\nready?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  analyze [label="1A. Analyze"];
  discovery [label="1B. Live discovery"];
  discovery_ok [shape=diamond, label="Discovery\ncomplete?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  discovery_handoff [label="Validated discovery handoff\n4+ AC: fresh author", fillcolor="#eff6ff"];
  discovery_issue [shape=diamond, label="What is\nblocked?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  plan_skip [label="Plan a genuine\nSKIPPED clause", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  analysis_ok [shape=diamond, label="Requirements checklist\nfilled in?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  fix_analysis [label="Complete requirements\nchecklist", fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d"];
  decide_scope [shape=diamond, label="Decision needed\nbefore authoring?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  ask_human [label="Ask one short\nhuman decision", fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d"];
  author [label="1C. Author specs\n+ test-plan checklist"];
  author_ok [shape=diamond, label="Test\ncomplete?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  check_fact [label="Check one missing fact\nlive; record it in Data", fillcolor="#eff6ff"];
  fix_draft [label="Add test details", fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d"];
  preflight [label="1D. Preflight\n+ handoff"];
  preflight_ok [shape=diamond, label="Preflight\npasses?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  fix_spec [label="Fix spec only\nthen preflight again", fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d"];
  executor [label="2A. Context decision\n<100k: author; ≥100k: executor\nre-verify + preflight + freeze"];
  handoff_ok [shape=diamond, label="Handoff and\npreflight valid?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  run [label="2B. Run fresh evidence\nreset/seed each scenario"];
  result [shape=diamond, label="Classify this\nrun", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  pass [label="PASS\nkeep evidence", fillcolor="#dcfce7", color="#16a34a", fontcolor="#14532d"];
  fail [label="FAIL\nkeep evidence", fillcolor="#ffedd5", color="#ea580c", fontcolor="#7c2d12"];
  skipped [label="SKIPPED\nrun blocked path + attach evidence", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  diag [label="Technical fault\n(not a final result)\ndiagnose once", fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d"];
  diag_kind [shape=diamond, label="Foundation or\nspec fault?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  report [label="2C. Report\ngenerate + verify"];
  report_ok [shape=diamond, label="Fresh report and\nverifier pass?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  report_issue [shape=diamond, label="Only the report\nbroken?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  review [label="2D. Independent review"];
  review_ok [shape=diamond, label="Evidence proves\nevery AC?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  handoff [label="Write final handoff\nfor coordinator", fillcolor="#eff6ff"];
  teardown [label="3. Teardown + restore\nshared stack", fillcolor="#f1f5f9", color="#64748b", fontcolor="#334155"];
  teardown_ok [shape=diamond, label="Teardown safely\nidentified?", fillcolor="#fef3c7", color="#d97706", fontcolor="#78350f"];
  done [label="Campaign complete", fillcolor="#dcfce7", color="#16a34a", fontcolor="#14532d"];
  teardown_stop [label="Stop campaign → later\nfoundation task: fix safely", fillcolor="#fee2e2", color="#dc2626", fontcolor="#7f1d1d"];

  foundation -> ready;
  ready -> campaign_start [label=" yes"];
  ready -> foundation_fix [label=" no"];
  foundation_fix -> foundation [label=" re-smoke"];
  campaign_start -> campaign_ready;
  campaign_ready -> analyze [label=" yes"];
  campaign_ready -> foundation_fix [label=" no"];
  analyze -> discovery;
  discovery -> discovery_ok;
  discovery_ok -> discovery_handoff [label=" yes: 4+ AC"];
  discovery_ok -> analysis_ok [label=" yes: smaller story"];
  discovery_handoff -> analysis_ok [label=" fresh author"];
  discovery_ok -> discovery_issue [label=" no"];
  discovery_issue -> foundation [label=" shared foundation"];
  discovery_issue -> plan_skip [label=" story precondition"];
  plan_skip -> analysis_ok;
  analysis_ok -> decide_scope [label=" yes"];
  analysis_ok -> fix_analysis [label=" no"];
  fix_analysis -> analysis_ok [label=" validate again"];
  decide_scope -> author [label=" no"];
  decide_scope -> ask_human [label=" yes"];
  ask_human -> author [label=" decision recorded"];
  author -> author_ok;
  author_ok -> preflight [label=" yes"];
  author_ok -> check_fact [label=" one live fact missing"];
  check_fact -> author;
  author_ok -> fix_draft [label=" need test details"];
  fix_draft -> author;
  preflight -> preflight_ok;
  preflight_ok -> executor [label=" yes"];
  preflight_ok -> fix_spec [label=" no"];
  fix_spec -> preflight;
  executor -> handoff_ok;
  handoff_ok -> run [label=" yes"];
  handoff_ok -> preflight [label=" no"];
  run -> result;
  result -> pass [label=" matches AC"];
  result -> fail [label=" product differs"];
  result -> skipped [label=" setup unavailable"];
  result -> diag [label=" harness/spec fault"];
  diag -> diag_kind;
  diag_kind -> foundation [label=" foundation"];
  diag_kind -> preflight [label=" test/spec"];
  pass -> report;
  fail -> report;
  skipped -> report;
  report -> report_ok;
  report_ok -> review [label=" yes"];
  report_ok -> report_issue [label=" no"];
  report_issue -> report [label=" yes"];
  report_issue -> preflight [label=" no: stale/incomplete"];
  review -> review_ok;
  review_ok -> handoff [label=" yes"];
  handoff -> teardown;
  review_ok -> diag [label=" no: false verdict or\nweak proof"];
  teardown -> teardown_ok;
  teardown_ok -> done [label=" yes"];
  teardown_ok -> teardown_stop [label=" no"];
}
