<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backend</name>
	<description>Secured Hello World API</description>
	<properties>
		<java.version>21</java.version>
		<jacoco.version>0.8.15</jacoco.version>
		<coverage.minimum>0.80</coverage.minimum>
		<dependency-check.version>13.0.0</dependency-check.version>
		<!-- CVSS v3 9.0 and above is Critical: those fail the security profile's build. -->
		<critical.cvss>9</critical.cvss>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
		</dependency>
		<!-- health and prometheus on a separate management port (story 111); never routed publicly. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-session-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Trace and span IDs in every request's log lines; nothing is exported. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-brave</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-brave</artifactId>
		</dependency>

		<!--
		Flyway 10 split per-vendor support out of flyway-core, and the JDBC drivers ship with the
		application because the deployment picks the vendor. H2 is dev and tests; Postgres is the
		production target; the MySQL migration set is maintained too. Without the matching
		flyway-* module Flyway refuses the connection outright ("Unsupported Database"), which is
		what NonH2MigrationTest exists to catch.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-session-jdbc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
			NonH2MigrationTest needs the Testcontainers and JDBC-driver dependencies that only the
			`migrations` profile brings in, so the ordinary build does not compile it and does not
			download them. The profile puts both back.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<testExcludes>
						<testExclude>**/NonH2MigrationTest.java</testExclude>
					</testExcludes>
				</configuration>
			</plugin>
			<!-- Every test context writes its logs to the same files, which the log-capture seam reads. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<app.logging.directory>${project.build.directory}/test-logs</app.logging.directory>
						<!-- A size rollover in the middle of a test would hide the lines it captured. -->
						<app.logging.application-max-file-size>1GB</app.logging.application-max-file-size>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<!-- Coverage gate: `mvn verify` fails below 80% line or branch coverage. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<excludes>
						<!-- The main() launcher only; its configuration is covered by every context test. -->
						<exclude>com/example/securedhello/BackendApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.minimum}</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
		Non-H2 migrations: `mvn -P migrations test -Dtest=NonH2MigrationTest` runs the Postgres and
		MySQL migration sets against a real Postgres and a real MySQL in throwaway containers, with
		Hibernate's ddl-auto=validate proving the schema still matches the entities. Kept out of the
		default build because it needs a Docker daemon and pulls two database images, which the
		ordinary `mvn verify` must not depend on. The README's deployment checklist requires a green
		run before any deployment targeting either vendor.
		-->
		<profile>
			<id>migrations</id>
			<dependencies>
				<dependency>
					<groupId>org.testcontainers</groupId>
					<artifactId>testcontainers-postgresql</artifactId>
					<scope>test</scope>
				</dependency>
				<dependency>
					<groupId>org.testcontainers</groupId>
					<artifactId>testcontainers-mysql</artifactId>
					<scope>test</scope>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<!-- Compile the test the default build excludes; its dependencies are above. -->
							<testExcludes combine.self="override"/>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!--
		Dependency scan: `mvn -P security verify` runs OWASP Dependency-Check over the compile and
		runtime dependencies and fails the build on a critical CVE. Kept out of the default build
		because the scan needs the NVD data, which the ordinary `mvn verify` must not depend on. Export
		an NVD API key as NVD_API_KEY before running it. Wiring the scan into CI is out of scope
		(ADR 0001).
		-->
		<profile>
			<id>security</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
						<version>${dependency-check.version}</version>
						<configuration>
							<failBuildOnCVSS>${critical.cvss}</failBuildOnCVSS>
							<!--
							The NVD refuses the data download without an API key, so the scan needs one
							in NVD_API_KEY. The plugin reads the variable itself, keeping the key out of
							this file and out of any Maven property that debug logging could print
							(GHSA-qqhq-8r2c-c3f5). With no key the scan fails the build rather than
							reporting a clean result it has no data for.
							-->
							<nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
							<!-- Re-use the downloaded NVD data for a day, so repeated local runs are quick. -->
							<nvdValidForHours>24</nvdValidForHours>
							<formats>
								<format>HTML</format>
								<format>JSON</format>
							</formats>
							<!-- Test-only dependencies are never shipped, so they are not scanned. -->
							<skipTestScope>true</skipTestScope>
							<!-- Empty today: a reviewed false positive goes here instead of blocking the scan. -->
							<suppressionFiles>
								<suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
							</suppressionFiles>
						</configuration>
						<executions>
							<execution>
								<id>critical-cve-check</id>
								<phase>verify</phase>
								<goals>
									<goal>check</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
