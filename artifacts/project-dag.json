    { "id": "be_user_db_schema", "name": "users table (JPA entity + schema)", "duration_days": 0.5, "tooling": ["Spring Data JPA", "H2"] },
    { "id": "be_user_data_access", "name": "UserRepository", "duration_days": 0.5, "tooling": ["Spring Data JPA"] },
    { "id": "be_user_registration_service", "name": "Registration service (uniqueness, password policy, BCrypt)", "duration_days": 1, "tooling": ["Spring Security BCryptPasswordEncoder", "Bean Validation"] },
    { "id": "be_user_registration_routes", "name": "POST /api/auth/register", "duration_days": 0.25, "tooling": ["Spring Web MVC"] },
    { "id": "fe_register_form", "name": "Registration page & form", "duration_days": 0.5, "tooling": ["React"] },

    { "id": "be_auth_login_service", "name": "Login service (AuthenticationManager, session fixation, attempt reset)", "duration_days": 1, "tooling": ["Spring Security"] },
    { "id": "be_auth_login_routes", "name": "POST /api/auth/login, GET /api/auth/me, GET /api/auth/csrf", "duration_days": 0.25, "tooling": ["Spring Web MVC"] },
    { "id": "fe_login_form", "name": "Login page & form", "duration_days": 0.5, "tooling": ["React"] },

    { "id": "be_auth_lockout_service", "name": "Account lockout (failed_login_attempts, locked_until)", "duration_days": 1, "tooling": ["Spring Security", "Spring Data JPA"] },
    { "id": "be_auth_throttle_middleware", "name": "IP-level login throttle (sliding window)", "duration_days": 0.5, "tooling": ["Spring Web MVC"] },

    { "id": "be_auth_logout_routes", "name": "POST /api/auth/logout (session invalidation, cookie clearing)", "duration_days": 0.25, "tooling": ["Spring Security"] },
