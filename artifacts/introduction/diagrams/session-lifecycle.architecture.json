  "cards": [
    {
      "dot": "emerald",
      "title": "Normal path",
      "items": [
        "Get a CSRF token before any change",
        "Login swaps in a new session ID and a new token",
        "Logout deletes the session, and its token, on the server"
      ]
    },
    {
      "dot": "rose",
      "title": "Early endings",
      "items": [
        "30 minutes idle expires the session and its token; the SPA re-fetches a token",
        "Password reset, or an admin disabling, deleting or demoting a user, removes that user's sessions"
      ]
