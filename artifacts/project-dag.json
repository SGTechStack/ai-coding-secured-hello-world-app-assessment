    { "id": "be_hello_routes", "name": "GET /api/hello", "duration_days": 0.25, "tooling": ["Spring Web MVC"] },
    { "id": "fe_hello_page", "name": "Protected greeting page", "duration_days": 0.5, "tooling": ["React", "TanStack Query"] },

    { "id": "be_password_reset_db_schema", "name": "password_reset_tokens table (JPA entity)", "duration_days": 0.5, "tooling": ["Spring Data JPA"] },
