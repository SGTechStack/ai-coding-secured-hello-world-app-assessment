    { "id": "auth_service", "name": "Session auth foundation (Spring Security filter chain, Spring Session store, cookie serializer, CSRF, CORS)", "duration_days": 1, "tooling": ["Session auth (schema + data access + logic)", "Spring Security", "Spring Session"], "category": "backend" },
    { "id": "be_arch_tests", "name": "Backend architectural tests (ArchUnit layering rules)", "duration_days": 0.5, "tooling": ["ArchUnit (Spring Boot)"], "category": "backend" },

    { "id": "project_setup", "name": "Frontend project setup (Vite + React + TypeScript)", "duration_days": 0.25, "tooling": ["Vite scaffold"], "category": "infrastructure" },
