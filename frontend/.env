VITE_BASE_URL=/app
VITE_SIGNIN_URL=/welcome
# Sign-in is the SPA's own form (ADR-DEMO-0002: same origin, relative URLs only). Logout is the
# backend's POST /logout.
VITE_LOGIN_URL=/app/sign-in
VITE_LOGOUT_URL=/logout

VITE_APP_LOCALE=en-SG
VITE_APP_TITLE=DEMO
VITE_APP_DESCRIPTION="Your demo application for showcasing features."
