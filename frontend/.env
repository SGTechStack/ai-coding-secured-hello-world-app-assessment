VITE_BASE_URL=/app
VITE_SIGNIN_URL=/welcome
# Production builds are served by a backend running feat-oidc (dev/qa/preprod/prod), so login
# initiates the server-side OIDC flow. Logout stays /logout (backend does RP-initiated logout).
VITE_LOGIN_URL=/oauth2/authorization/aas
VITE_LOGOUT_URL=/logout

VITE_APP_LOCALE=en-SG
VITE_APP_TITLE=DEMO
VITE_APP_DESCRIPTION="Your demo application for showcasing features."
VITE_APP_WARNING_TITLE="This is a XXXXXX protected computer system."
VITE_APP_WARNING_DESCRIPTION="Unauthorised access, use, reproduction, possession, modification, interception, damage or transfer (including such attempts) of this system or any content therein are serious offences under the Computer Misuse Act."
