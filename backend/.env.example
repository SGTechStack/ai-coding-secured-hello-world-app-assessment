APP_ALLOWED_ORIGINS=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000
DATABASE_URL=jdbc:h2:file:./data/hello
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
