    { "id": "be_notification_integration", "name": "EmailService stub (logs reset link)", "duration_days": 0.25, "tooling": ["SLF4J"] },
    { "id": "be_password_reset_request_service", "name": "Reset request service (token generation, SHA-256 hash, expiry)", "duration_days": 1, "tooling": ["Spring Security"] },
    { "id": "be_password_reset_routes", "name": "POST /api/auth/password-reset/request and /confirm", "duration_days": 0.25, "tooling": ["Spring Web MVC"] },
    { "id": "fe_password_reset_request_form", "name": "Forgot-password page", "duration_days": 0.5, "tooling": ["React"] },

    { "id": "be_password_reset_confirm_service", "name": "Reset confirm service (single-use, expiry, session invalidation)", "duration_days": 1, "tooling": ["Spring Security", "Spring Session"] },
    { "id": "fe_password_reset_confirm_form", "name": "Reset-password page (token from URL)", "duration_days": 0.5, "tooling": ["React"] },

    { "id": "be_user_admin_service", "name": "Admin user service (list users as DTOs)", "duration_days": 0.5, "tooling": ["Spring Data JPA"] },
    { "id": "be_user_admin_routes", "name": "GET /api/admin/users (+ mutation routes)", "duration_days": 0.25, "tooling": ["Spring Web MVC", "Spring Security method security"] },
    { "id": "fe_user_admin_page", "name": "Admin users page", "duration_days": 0.5, "tooling": ["React", "TanStack Query"] },
    { "id": "fe_user_admin_list", "name": "User table component", "duration_days": 0.5, "tooling": ["React"] },

    { "id": "be_user_status_service", "name": "Enable/disable user (self-action guard)", "duration_days": 0.5, "tooling": ["Spring Data JPA"] },
    { "id": "fe_user_status_widget", "name": "Enable/disable toggle in user row", "duration_days": 0.25, "tooling": ["React", "TanStack Query"] },

    { "id": "be_user_role_service", "name": "Change user role (self-action guard)", "duration_days": 0.5, "tooling": ["Spring Data JPA"] },
    { "id": "fe_user_role_widget", "name": "Role select in user row", "duration_days": 0.25, "tooling": ["React", "TanStack Query"] },

    { "id": "be_user_delete_service", "name": "Delete user (self-action guard)", "duration_days": 0.5, "tooling": ["Spring Data JPA"] },
    { "id": "fe_user_delete_modal", "name": "Delete confirmation dialog", "duration_days": 0.5, "tooling": ["React"] },

    { "id": "be_user_admin_config", "name": "app.admin.* configuration properties", "duration_days": 0.25, "tooling": ["Spring Boot @ConfigurationProperties"] },
    { "id": "be_user_admin_bootstrap_job", "name": "Admin bootstrap ApplicationRunner", "duration_days": 0.5, "tooling": ["Spring Boot ApplicationRunner"] }
